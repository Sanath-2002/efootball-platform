# Environment Variables for Backend Service

PORT=5001
# Note: macOS AirPlay Receiver uses port 5000 by default — use 5001 for local dev
NODE_ENV=development

# Local PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://efootball:efootball@localhost:5432/efootball"

# JWT Secret Key (Use a long random string in production)
JWT_SECRET="your_production_secure_jwt_secret_key_2026"

# Allowed Origins for CORS (Comma-separated URLs of your frontend domain)
ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:3000"

# Screenshot storage: local (dev) or cloudinary (production)
STORAGE_DRIVER=local

# Cloudinary (required when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
